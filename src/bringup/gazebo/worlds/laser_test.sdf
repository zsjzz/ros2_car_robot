<?xml version="1.0"?>
<!--
	雷达测试围场,内部矩形尺寸为 10m x 6m,以世界原点为中心.
	四面围墙:内表面 x=+/-5m,y=+/-3m,墙厚 0.2m,墙高 1m.
	两条长边各有 4 个矩形凸起:x=-3,-1,1,3m,长 1m,向内伸出 0.5m.
	凸起正面位于 y=+/-2.5m,相邻凸起之间有 1m 平直墙面,最小通行宽度 5m.
-->
<sdf version="1.9">
	<world name="laser_test">
		<physics name="1ms" type="ignored">
			<max_step_size>0.001</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics" />
		<plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands" />
		<plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
		<plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact" />
		<plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>
		<light type="directional" name="sun">
			<cast_shadows>false</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>
		<model name="ground_plane">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>14 10</size>
						</plane>
					</geometry>
				</collision>
				<visual name="visual">
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>14 10</size>
						</plane>
					</geometry>
					<material>
						<ambient>0.8 0.8 0.8 1</ambient>
						<diffuse>0.8 0.8 0.8 1</diffuse>
						<specular>0.8 0.8 0.8 1</specular>
					</material>
				</visual>
			</link>
		</model>
		<model name="laser_test_enclosure">
			<static>true</static>
			<link name="walls">
				<collision name="north_wall">
					<pose>0 3.1 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>10.4 0.2 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="north_wall_visual">
					<pose>0 3.1 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>10.4 0.2 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.25 0.45 0.7 1</ambient>
						<diffuse>0.25 0.45 0.7 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="south_wall">
					<pose>0 -3.1 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>10.4 0.2 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="south_wall_visual">
					<pose>0 -3.1 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>10.4 0.2 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.25 0.45 0.7 1</ambient>
						<diffuse>0.25 0.45 0.7 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="east_wall">
					<pose>5.1 0 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>0.2 6 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="east_wall_visual">
					<pose>5.1 0 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>0.2 6 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.5 0.5 0.5 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="west_wall">
					<pose>-5.1 0 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>0.2 6 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="west_wall_visual">
					<pose>-5.1 0 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>0.2 6 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.5 0.5 0.5 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="north_tooth_01">
					<pose>-3 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="north_tooth_01_visual">
					<pose>-3 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="north_tooth_02">
					<pose>-1 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="north_tooth_02_visual">
					<pose>-1 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="north_tooth_03">
					<pose>1 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="north_tooth_03_visual">
					<pose>1 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="north_tooth_04">
					<pose>3 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="north_tooth_04_visual">
					<pose>3 2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="south_tooth_01">
					<pose>-3 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="south_tooth_01_visual">
					<pose>-3 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="south_tooth_02">
					<pose>-1 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="south_tooth_02_visual">
					<pose>-1 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="south_tooth_03">
					<pose>1 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="south_tooth_03_visual">
					<pose>1 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
				<collision name="south_tooth_04">
					<pose>3 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
				</collision>
				<visual name="south_tooth_04_visual">
					<pose>3 -2.75 0.5 0 0 0</pose>
					<geometry>
						<box>
							<size>1 0.5 1</size>
						</box>
					</geometry>
					<material>
						<ambient>0.85 0.45 0.15 1</ambient>
						<diffuse>0.85 0.45 0.15 1</diffuse>
					</material>
					<cast_shadows>false</cast_shadows>
				</visual>
			</link>
		</model>
	</world>
</sdf>
