<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
	<name>robot_control</name>
	<version>0.0.1</version>
	<description>ros2_control interface declaration for the four-wheel differential-drive car. Describes which joints are controllable and how, independent of the hardware backend.</description>
	<maintainer email="shengjiang.zhong@siengine.com">shengjiang.zhong</maintainer>
	<license>Apache-2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<exec_depend>robot_description</exec_depend>
	<exec_depend>controller_manager</exec_depend>
	<exec_depend>diff_drive_controller</exec_depend>
	<exec_depend>joint_state_broadcaster</exec_depend>
	<exec_depend>robot_state_publisher</exec_depend>
	<exec_depend>ros2_control</exec_depend>
	<exec_depend>xacro</exec_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
